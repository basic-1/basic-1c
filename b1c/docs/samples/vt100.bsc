REM User-defined function with optional arguments (VT100TEXT$)

CONST _VT100ESST$ = CHR$(27) + "["
CONST _VT100ESEND$ = CHR$(27) + "[0m"

CONST vt100DEF AS BYTE = 9
CONST vt100BLACK AS BYTE = 0, vt100RED AS BYTE = 1, vt100GREEN AS BYTE = 2, vt100YELLOW AS BYTE = 3, vt100BLUE AS BYTE = 4, vt100MAGENTA AS BYTE = 5, vt100CYAN AS BYTE = 6, vt100WHITE AS BYTE = 7
CONST vt100BOLD AS BYTE = 1, vt100DIM AS BYTE = 2, vt100UNDERLINED AS BYTE = 4, vt100BLINK AS BYTE = 5, vt100REVERSE AS BYTE = 7, vt100HIDDEN AS BYTE = 8

DEF VT100TEXT$(TEXT$, TXCOL AS BYTE = vt100DEF, BGCOL AS BYTE = vt100DEF, STYLE AS BYTE = vt100DEF) = _VT100ESST$ + IIF$(STYLE = vt100DEF, "", STYLE + ";") + "3" + TXCOL + ";4" + BGCOL + "m" + TEXT$ + _VT100ESEND$


IOCTL UART, ENABLE
IOCTL UART, START


WHILE 1 > 0
PRINT "Default" + " " + VT100TEXT$("dimmed",,, vt100DIM) + " " + VT100TEXT$("bold",,, vt100BOLD) + " " + VT100TEXT$("underlined",,, vt100UNDERLINED)
PRINT VT100TEXT$("Red", vt100RED,,)
PRINT VT100TEXT$("Cyan", vt100CYAN,,)
PRINT VT100TEXT$("Red reversed", vt100RED, , vt100REVERSE)
PRINT VT100TEXT$("Green on black", vt100GREEN, vt100BLACK,)
PRINT VT100TEXT$("Green on black reversed", vt100GREEN, vt100BLACK, vt100REVERSE)
PRINT VT100TEXT$("Yellow on blue", vt100YELLOW, vt100BLUE,)
PRINT VT100TEXT$("Yellow on blue bold", vt100YELLOW, vt100BLUE, vt100BOLD)
PRINT VT100TEXT$("Black on magenta blink",vt100BLACK, vt100MAGENTA, vt100BLINK)

INPUT S$
WEND

END