; transfers array data over SPI bus (full-duplex mode)
; A1 - address of data to send, A2 - the data size (in bytes)
ASM
LBU A0, 0(A1)
SH A0, SPI1_DATAR

ADDI A2, A2, -1
BEQ A2, ZERO, ::__LBL_LAST_BYTE

:::__LBL_NEXT
LBU T1, 1(A1)

:::__LBL_WAIT_SPI_TXE
LHU A0, SPI1_STATR
ANDI A0, A0, SPI1_STATR_TXE
BEQ A0, ZERO, ::__LBL_WAIT_SPI_TXE
SH T1, SPI1_DATAR

:::__LBL_WAIT_SPI_RXNE
LHU A0, SPI1_STATR
ANDI A0, A0, SPI1_STATR_RXNE
BEQ A0, ZERO, ::__LBL_WAIT_SPI_RXNE
LHU A0, SPI1_DATAR

SB A0, 0(A1)
ADDI A1, A1, 1

ADDI A2, A2, -1
BNE A2, ZERO, ::__LBL_NEXT

:::__LBL_LAST_BYTE
LHU A0, SPI1_STATR
ANDI A0, A0, SPI1_STATR_RXNE
BEQ A0, ZERO, ::__LBL_LAST_BYTE
LHU A0, SPI1_DATAR

SB A0, 0(A1)
ENDASM