; sends 32-bit integer value from A0 register over SPI bus
ASM
LI T1, 4

:::__LBL_NEXT
SRLI T2, A0, 24

:::__LBL_WAIT_SPI_TXE
LHU T0, SPI1_STATR
ANDI T0, T0, SPI1_STATR_TXE
BEQ T0, ZERO, ::__LBL_WAIT_SPI_TXE

SH T2, SPI1_DATAR

SLLI A0, A0, 8
ADDI T1, T1, -1
BNE T1, ZERO, ::__LBL_NEXT
ENDASM