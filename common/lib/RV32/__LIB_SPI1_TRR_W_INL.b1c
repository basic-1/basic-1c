; transfers 16-bit (2 bytes) value over SPI bus (full-duplex mode)
; A0 - value to send, S0 - value read from SPI
ASM
SRLI S0, A0, 8
SH S0, SPI1_DATAR

:::__LBL_WAIT_SPI_TXE
LHU S0, SPI1_STATR
ANDI S0, S0, SPI1_STATR_TXE
BEQ S0, ZERO, ::__LBL_WAIT_SPI_TXE
SH A0, SPI1_DATAR

:::__LBL_WAIT_SPI_RXNE
LHU S0, SPI1_STATR
ANDI S0, S0, SPI1_STATR_RXNE
BEQ S0, ZERO, ::__LBL_WAIT_SPI_RXNE
LHU A0, SPI1_DATAR
SLLI A0, A0, 8

:::__LBL_WAIT_SPI_RXNE_1
LHU S0, SPI1_STATR
ANDI S0, S0, SPI1_STATR_RXNE
BEQ S0, ZERO, ::__LBL_WAIT_SPI_RXNE_1
LHU S0, SPI1_DATAR
OR S0, S0, A0
ENDASM
