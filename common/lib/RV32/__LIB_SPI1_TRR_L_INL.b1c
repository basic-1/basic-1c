; transfers 32-bit (4 bytes) value over SPI bus (full-duplex mode)
; A0 - value to send, S0 - value read from SPI
ASM
LI T1, 3

SRLI S0, A0, 24
SH S0, SPI1_DATAR
SLLI A0, A0, 8

:::__LBL_NEXT
SRLI T2, A0, 24

:::__LBL_WAIT_SPI_TXE
LHU S0, SPI1_STATR
ANDI S0, S0, SPI1_STATR_TXE
BEQ S0, ZERO, ::__LBL_WAIT_SPI_TXE
SH T2, SPI1_DATAR

:::__LBL_WAIT_SPI_RXNE
LHU S0, SPI1_STATR
ANDI S0, S0, SPI1_STATR_RXNE
BEQ S0, ZERO, ::__LBL_WAIT_SPI_RXNE
LHU T2, SPI1_DATAR

OR A0, A0, T2
SLLI A0, A0, 8

ADDI T1, T1, -1
BNE T1, ZERO, ::__LBL_NEXT

:::__LBL_WAIT_SPI_RXNE_1
LHU S0, SPI1_STATR
ANDI S0, S0, SPI1_STATR_RXNE
BEQ S0, ZERO, ::__LBL_WAIT_SPI_RXNE_1
LHU S0, SPI1_DATAR
OR S0, S0, A0
ENDASM
