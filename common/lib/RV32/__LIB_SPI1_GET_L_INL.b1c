; reads a 32-bit integer value (LONG) from SPI bus and stores it in S0 register
ASM
LI T1, 4

:::__LBL_NEXT
SLLI S0, S0, 8

:::__LBL_WAIT_SPI_RXNE
LHU A0, SPI1_STATR
ANDI A0, A0, SPI1_STATR_RXNE
BEQ A0, ZERO, ::__LBL_WAIT_SPI_RXNE
LHU A0, SPI1_DATAR

ADD S0, S0, A0
ADDI T1, T1, -1
BNE T1, ZERO, ::__LBL_NEXT
ENDASM