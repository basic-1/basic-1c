; reads a 16-bit integer value (INT/WORD) from SPI bus and stores it in S0 register
ASM
:::__LBL_WAIT_SPI_RXNE_1
LHU A0, SPI1_STATR
ANDI A0, A0, SPI1_STATR_RXNE
BEQ A0, ZERO, ::__LBL_WAIT_SPI_RXNE_1
LHU S0, SPI1_DATAR
SLLI S0, S0, 8
:::__LBL_WAIT_SPI_RXNE_2
LHU A0, SPI1_STATR
ANDI A0, A0, SPI1_STATR_RXNE
BEQ A0, ZERO, ::__LBL_WAIT_SPI_RXNE_2
LHU A0, SPI1_DATAR
ADD S0, S0, A0
ENDASM