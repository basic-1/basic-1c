; sends 16-bit integer value from A0 register over SPI bus
ASM
SRLI T1, A0, 8
ANDI T2, A0, 0xFF

:::__LBL_WAIT_SPI_TXE_1
LHU A0, SPI1_STATR
ANDI A0, A0, SPI1_STATR_TXE
BEQ A0, ZERO, ::__LBL_WAIT_SPI_TXE_1
SH T1, SPI1_DATAR
:::__LBL_WAIT_SPI_TXE_2
LHU A0, SPI1_STATR
ANDI A0, A0, SPI1_STATR_TXE
BEQ A0, ZERO, ::__LBL_WAIT_SPI_TXE_2
SH T2, SPI1_DATAR
ENDASM