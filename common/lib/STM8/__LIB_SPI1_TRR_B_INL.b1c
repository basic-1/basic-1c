; transfers one byte over SPI bus (full-duplex mode)
; A - byte to send, returns byte read from SPI bus in A
ASM
:::__LBL_WAIT_SPI1_TXE
BTJF (SPI1_SR), SPI1_SR_TXE_POS, ::__LBL_WAIT_SPI1_TXE
LD (SPI1_DR), A
:::__LBL_WAIT_SPI1_RXNE
BTJF (SPI1_SR), SPI1_SR_RXNE_POS, ::__LBL_WAIT_SPI1_RXNE
LD A, (SPI1_DR)
ENDASM
