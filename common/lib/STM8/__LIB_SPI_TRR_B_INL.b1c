; transfers one byte over SPI bus (full-duplex mode)
; A - byte to send, returns byte read from SPI bus in A
ASM
:::__LBL_WAIT_SPI_TXE
BTJF (SPI_SR), SPI_SR_TXE_POS, ::__LBL_WAIT_SPI_TXE
LD (SPI_DR), A
:::__LBL_WAIT_SPI_RXNE
BTJF (SPI_SR), SPI_SR_RXNE_POS, ::__LBL_WAIT_SPI_RXNE
LD A, (SPI_DR)
ENDASM
