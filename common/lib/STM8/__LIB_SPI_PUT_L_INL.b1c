; sends a 32-bit integer value from X:Y register pair over SPI bus
ASM
PUSH 0xA ; 1010

:::__LBL_NEXT
RLWA Y

:::__LBL_WAIT_SPI_TXE
BTJF (SPI_SR), SPI_SR_TXE_POS, ::__LBL_WAIT_SPI_TXE
LD (SPI_DR), A
SRL (1, SP)
JRNC ::__LBL_NO_EXG_XY
EXGW X, Y

:::__LBL_NO_EXG_XY
JRNE ::__LBL_NEXT
POP A
ENDASM