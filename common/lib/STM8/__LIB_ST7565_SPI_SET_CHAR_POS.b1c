INI,__LIB_ST7565_SPI_COL
INI,__LIB_ST7565_SPI_ROW
INI,__LIB_ST7565_SPI_FONT_OPT
INI,__LIB_ST7565_SPI_OPT
IMP,__LIB_ST7565_SPI_SET_PAGE_ADDR
IMP,__LIB_ST7565_SPI_SET_COL_ADDR

; sets ST7565 position to draw a char
; A - 0 (position to draw upper part of a 8x16 character) or 1 (position
; to draw lower part of the character). The parameter has no sence in case
; of 8x8 font
DEF,__LIB_ST7565_SPI_SET_CHAR_POS,NONE,BYTE
:__LIB_ST7565_SPI_SET_CHAR_POS
LA,::__LCL_TMP_0,BYTE
=,__LIB_ST7565_SPI_ROW<BYTE>,::__LCL_TMP_0<BYTE>
<,__LIB_ST7565_SPI_FONT_OPT<BYTE>,0x80<BYTE>
JT,::__LBL_8X8_FONT
<<,::__LCL_TMP_0<BYTE>,1<BYTE>,::__LCL_TMP_0<BYTE>
+,::__LCL_TMP_0<BYTE>,__ARG_0<BYTE>,::__LCL_TMP_0<BYTE>

:::__LBL_8X8_FONT
LA,::__LCL_TMP_1,BYTE
>>,__LIB_ST7565_SPI_OPT<BYTE>,1<BYTE>,::__LCL_TMP_1<BYTE> ; take into account display start line
+,::__LCL_TMP_1<BYTE>,::__LCL_TMP_0<BYTE>,::__LCL_TMP_0<BYTE>
LF,::__LCL_TMP_1
&,::__LCL_TMP_0<BYTE>,7<BYTE>,::__LCL_TMP_0<BYTE>
CALL,__LIB_ST7565_SPI_SET_PAGE_ADDR,::__LCL_TMP_0<BYTE>
<<,__LIB_ST7565_SPI_COL<BYTE>,3<BYTE>,::__LCL_TMP_0<BYTE>
CALL,__LIB_ST7565_SPI_SET_COL_ADDR,::__LCL_TMP_0<BYTE>
LF,::__LCL_TMP_0
RET
