INI,__LIB_SPI_OPT
INI,__LIB_SPI_OPT1
INI,__LIB_SPI_SS_PIN

; stop SPI (STOP)
:__LIB_SPI_6_CALL
ASM
; disabling SPI in case of master half-duplex RX or master simplex RX-only mode
; is not implemented (because the procedure is a bit odd)
BTJT (__LIB_SPI_OPT1), 3, ::__LBL_DISABLE_SLAVE

; slave mode
; see errata: BSY flag can get stuck in slave mode so do not check it.
; TX mode: the caller must ensure the transmission already completed
BTJF (__LIB_SPI_OPT), 2, ::__LBL_DISABLE_SPI

; master full-duplex, simplex TX-only or half-duplex TX mode
:::__LBL_WAIT_SPI_TXE
BTJF (SPI_SR), SPI_SR_TXE_POS, ::__LBL_WAIT_SPI_TXE

:::__LBL_WAIT_SPI_BSY
BTJT (SPI_SR), SPI_SR_BSY_POS, ::__LBL_WAIT_SPI_BSY

:::__LBL_DISABLE_SPI
; clear OVR flag
LD A, (SPI_DR)
LD A, (SPI_SR)

BRES (SPI_CR1), SPI_CR1_SPE_POS
; set NSS pin high (disable slave device)
BTJF (__LIB_SPI_OPT), 2, ::__LBL_EXIT

:::__LBL_DISABLE_SLAVE
TNZ (__LIB_SPI_SS_PIN)
JREQ ::__LBL_EXIT
CALLR __LIB_SPI_NSS_HI

:::__LBL_EXIT
RET
ENDASM