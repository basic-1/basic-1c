; reads a 32-bit integer value from SPI bus and stores it in Y:X register pair
ASM
PUSH 0xA ; 1010

:::__LBL_WAIT_SPI1_RXNE
BTJF (SPI1_SR), SPI1_SR_RXNE_POS, ::__LBL_WAIT_SPI1_RXNE
LD A, (SPI1_DR)

RLWA Y
SRL (1, SP)
JRNC ::__LBL_NO_EXG_XY
EXGW X, Y

:::__LBL_NO_EXG_XY
JRNE ::__LBL_WAIT_SPI1_RXNE

POP A
ENDASM