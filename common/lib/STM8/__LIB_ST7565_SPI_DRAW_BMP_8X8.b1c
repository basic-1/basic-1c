INI,__LIB_ST7565_SPI_OPT1

; draw 8x8 bitmaps
; stack1 - bitmaps count (BYTE), stack2 - bitmap data address (WORD)
DEF,__LIB_ST7565_SPI_DRAW_BMP_8X8,NONE,BYTE,WORD
:__LIB_ST7565_SPI_DRAW_BMP_8X8
; select data mode
CALL,__LIB_ST7565_SPI_DC_HI

LA,::__LCL_TMP_0,WORD
<<,CWRD<WORD>(__ARG_0<BYTE>),3<BYTE>,::__LCL_TMP_0<WORD>
LA,::__LCL_TMP_1,WORD
=,__ARG_1<WORD>,::__LCL_TMP_1<WORD>
+,::__LCL_TMP_1<WORD>,::__LCL_TMP_0<WORD>,::__LCL_TMP_0<WORD>

LA,::__LCL_TMP_2,BYTE
=,0<BYTE>,::__LCL_TMP_2<BYTE>
<,__LIB_ST7565_SPI_OPT1<BYTE>,0x80<BYTE>
JT,::__LBL_WRITE_LOOP
!,::__LCL_TMP_2<BYTE>,::__LCL_TMP_2<BYTE>

:::__LBL_WRITE_LOOP
LA,::__LCL_TMP_3,BYTE
~,PEEK<BYTE>(::__LCL_TMP_1<WORD>),::__LCL_TMP_2<BYTE>,::__LCL_TMP_3<BYTE>
PUT,SPI,::__LCL_TMP_3<BYTE>
LF,::__LCL_TMP_3
+,::__LCL_TMP_1<WORD>,1<WORD>,::__LCL_TMP_1<WORD>
==,::__LCL_TMP_1<WORD>,::__LCL_TMP_0<WORD>
JF,::__LBL_WRITE_LOOP

LF,::__LCL_TMP_2
LF,::__LCL_TMP_1
LF,::__LCL_TMP_0
RET
