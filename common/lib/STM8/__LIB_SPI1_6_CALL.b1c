INI,__LIB_SPI1_OPT
INI,__LIB_SPI1_OPT1
INI,__LIB_SPI1_SS_PIN

; stop SPI1 (STOP)
:__LIB_SPI1_6_CALL
ASM
; disabling SPI in case of master half-duplex RX or master simplex RX-only mode
; is not implemented (because the procedure is a bit odd)
BTJT (__LIB_SPI1_OPT1), 3, ::__LBL_DISABLE_SLAVE

; slave mode
; see errata: BSY flag can get stuck in slave mode so do not check it.
; TX mode: the caller must ensure the transmission already completed
BTJF (__LIB_SPI1_OPT), 2, ::__LBL_DISABLE_SPI1

; master full-duplex, simplex TX-only or half-duplex TX mode
:::__LBL_WAIT_SPI1_TXE
BTJF (SPI1_SR), SPI1_SR_TXE_POS, ::__LBL_WAIT_SPI1_TXE

:::__LBL_WAIT_SPI1_BSY
BTJT (SPI1_SR), SPI1_SR_BSY_POS, ::__LBL_WAIT_SPI1_BSY

:::__LBL_DISABLE_SPI1
; clear OVR flag
LD A, (SPI1_DR)
LD A, (SPI1_SR)

BRES (SPI1_CR1), SPI1_CR1_SPE_POS
; set NSS pin high (disable slave device)
BTJF (__LIB_SPI1_OPT), 2, ::__LBL_EXIT

:::__LBL_DISABLE_SLAVE
TNZ (__LIB_SPI1_SS_PIN)
JREQ ::__LBL_EXIT
CALLR __LIB_SPI1_NSS_HI

:::__LBL_EXIT
RET
ENDASM