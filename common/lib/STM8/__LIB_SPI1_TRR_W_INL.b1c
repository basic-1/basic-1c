; transfers 16-bit integer value over SPI bus (full-duplex mode)
; X - value to send, returns value read from SPI bus in X
ASM
PUSH 2

:::__LBL_WAIT_SPI1_TXE
BTJF (SPI1_SR), SPI1_SR_TXE_POS, ::__LBL_WAIT_SPI1_TXE

:::__LBL_NEXT
RLWA X
LD (SPI1_DR), A

:::__LBL_WAIT_SPI1_RXNE
BTJF (SPI1_SR), SPI1_SR_RXNE_POS, ::__LBL_WAIT_SPI1_RXNE
LD A, (SPI1_DR)

DEC (1, SP)
JRNE ::__LBL_NEXT

RLWA X
POP A
ENDASM
