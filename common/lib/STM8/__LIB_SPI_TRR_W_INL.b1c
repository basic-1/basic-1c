; transfers 16-bit integer value over SPI bus (full-duplex mode)
; X - value to send, returns value read from SPI bus in X
ASM
PUSH 2

:::__LBL_WAIT_SPI_TXE
BTJF (SPI_SR), SPI_SR_TXE_POS, ::__LBL_WAIT_SPI_TXE

:::__LBL_NEXT
RLWA X
LD (SPI_DR), A

:::__LBL_WAIT_SPI_RXNE
BTJF (SPI_SR), SPI_SR_RXNE_POS, ::__LBL_WAIT_SPI_RXNE
LD A, (SPI_DR)

DEC (1, SP)
JRNE ::__LBL_NEXT

RLWA X
POP A
ENDASM
