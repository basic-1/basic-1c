; sets ST7565 page address
; A - page address (0..8)
DEF,__LIB_ST7565_SPI_SET_PAGE_ADDR,NONE,BYTE
:__LIB_ST7565_SPI_SET_PAGE_ADDR
CALL,__LIB_ST7565_SPI_DC_LO ; select command mode
LA,::__LCL_TMP_0,BYTE
&,__ARG_0<BYTE>,0xF<BYTE>,::__LCL_TMP_0<BYTE>
|,::__LCL_TMP_0<BYTE>,0xB0<BYTE>,::__LCL_TMP_0<BYTE> ; set page address command
PUT,SPI,::__LCL_TMP_0<BYTE>
LF,::__LCL_TMP_0
RET
